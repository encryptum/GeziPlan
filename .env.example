# Mapbox public token (pk.*) — https://account.mapbox.com/access-tokens/
# Geocoding API ve Directions API etkin olmalı.
VITE_MAPBOX_ACCESS_TOKEN=pk.your_mapbox_token_here

# Supabase — Project Settings → API
# URL sadece proje kökü olmalı (/rest/v1 EKLEMEYİN):
VITE_SUPABASE_URL=https://your-project.supabase.co
# "anon" "public" anahtarı (eyJ... veya sb_publishable_... ile başlar)
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# AI (Supabase Edge Function secrets — .env'e DEĞİL, supabase secrets set ile)
# GEMINI_API_KEY=...        # Google AI Studio
# OPENAI_API_KEY=...        # OpenAI (gpt-4o-mini, gpt-4o)
# DEEPSEEK_API_KEY=...      # DeepSeek (deepseek-chat, deepseek-reasoner)
# MAPBOX_ACCESS_TOKEN=...   # POI araması için (mapbox-proxy ile aynı)
# Provider/model seçimi gezi bazlıdır — organizatör TripAiSettings'ten seçer

# Giriş için Yöneticinin Belirlediği Ortak Şifre (En az 6 karakter olmalıdır)
VITE_SITE_PASSWORD=your_site_password_here
